+static unsigned int erofs_d_hash(const char *name)
+{
+	unsigned int h = 2166136261u;
+
+	while (*name)
+		h = (h ^ (unsigned char)*name++) * 16777619u;
+	return h;
+}
+
+static void erofs_d_index_put(struct erofs_inode *dir, struct erofs_dentry *d)
+{
+	unsigned int i = erofs_d_hash(d->name) & dir->i_dindex_mask;
+
+	while (dir->i_dindex[i])
+		i = (i + 1) & dir->i_dindex_mask;
+	dir->i_dindex[i] = d;
+	++dir->i_dindex_used;
+}
+
+void erofs_d_index_drop(struct erofs_inode *dir)
+{
+	free(dir->i_dindex);
+	dir->i_dindex = NULL;
+	dir->i_dindex_mask = dir->i_dindex_used = 0;
+}
+
+/* index the @count dentries of @dir at a load of at most half; on ENOMEM lookups stay linear */
+void erofs_d_index_build(struct erofs_inode *dir, unsigned int count)
+{
+	unsigned int size = 64;
+	struct erofs_dentry *d;
+
+	if (count >= 1U << 30)
+		return;
+	while (size < 2 * count + 2)
+		size <<= 1;
+	erofs_d_index_drop(dir);
+	dir->i_dindex = calloc(size, sizeof(*dir->i_dindex));
+	if (!dir->i_dindex)
+		return;
+	dir->i_dindex_mask = size - 1;
+	list_for_each_entry(d, &dir->i_subdirs, d_child)
+		erofs_d_index_put(dir, d);
+}
+
+struct erofs_dentry *erofs_d_index_lookup(struct erofs_inode *dir,
+					  const char *name)
+{
+	unsigned int i = erofs_d_hash(name) & dir->i_dindex_mask;
+	struct erofs_dentry *d;
+
+	while ((d = dir->i_dindex[i])) {
+		if (!strcmp(d->name, name))
+			return d;
+		i = (i + 1) & dir->i_dindex_mask;
+	}
+	return NULL;
+}
+
